# ── AI Models ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Search ───────────────────────────────────────────────────────────────────
SERPER_API_KEY=your-serper-key-here   # Free at serper.dev (2500 searches/month)

# ── Email (optional — for daily digest) ──────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key-here
DIGEST_EMAIL_TO=rizwanzaffar.pk@gmail.com
DIGEST_EMAIL_FROM=noreply@your-domain.com

# ── Railway / Deployment ─────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development   # development | production
SECRET_KEY=your-random-secret-key-change-this

# ── Scheduling ────────────────────────────────────────────────────────────────
JOB_SCOUT_TIME=09:00       # Daily job search time (Dubai/UTC+4)
BOSS_AGENT_TIME=21:00      # Evening audit time
TIMEZONE=Asia/Dubai
