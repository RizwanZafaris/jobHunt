# ── AI Models ────────────────────────────────────────────────────────────────
# Required (existing):
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — Phase 0 multi-LLM router. Add when you arrange keys.
# Get them at:
#   Gemini:    https://aistudio.google.com/apikey
#   DeepSeek:  https://platform.deepseek.com/api_keys
#   Kimi:      https://platform.moonshot.ai/console/api-keys
GOOGLE_API_KEY=                        # Gemini 2.5 Pro (G1 synth + G2 insider/meta-critic)
DEEPSEEK_API_KEY=                      # V3 (batch scoring) + R1 (ATS critic, mock critic)
KIMI_API_KEY=                          # K2 (red-flag verify, ensemble ATS critic)

# Per-agent provider override (rare — only when you want a non-default routing).
# Leave blank to let the router infer from the model name.
COMPANY_AGENT_PROVIDER=
RIZWAN_AGENT_PROVIDER=
INTERVIEW_AGENT_PROVIDER=
BOSS_AGENT_PROVIDER=
JOB_SCOUT_PROVIDER=

# G2 (Resume Builder graph) per-node model overrides — defaults are sane.
# G2_INSIDER_EXPERT_MODEL=gemini-2.5-pro
# G2_ADVOCATE_MODEL=claude-opus-4-5-20251101
# G2_META_CRITIC_MODEL=gemini-2.5-pro
# G2_WRITER_MODEL=claude-opus-4-5-20251101
# G2_ATS_CRITIC_A_MODEL=deepseek-reasoner
# G2_ATS_CRITIC_B_MODEL=kimi-k2
# G2_ORCHESTRATOR_MODEL=claude-opus-4-5-20251101
# G2_POLISHER_MODEL=claude-opus-4-5-20251101

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Search ───────────────────────────────────────────────────────────────────
SERPER_API_KEY=your-serper-key-here   # Free at serper.dev (2500 searches/month)

# ── Email (optional — for daily digest) ──────────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key-here
DIGEST_EMAIL_TO=rizwanzaffar.pk@gmail.com
DIGEST_EMAIL_FROM=noreply@your-domain.com

# ── Railway / Deployment ─────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development   # development | production
SECRET_KEY=your-random-secret-key-change-this

# ── Scheduling ────────────────────────────────────────────────────────────────
JOB_SCOUT_TIME=09:00       # Daily job search time (Dubai/UTC+4)
BOSS_AGENT_TIME=21:00      # Evening audit time
TIMEZONE=Asia/Dubai
