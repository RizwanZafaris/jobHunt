# jobHunt — canonical environment variables.
#
# This file is the single source of truth for what env vars exist. The
# CI config-check script (scripts/check-prod-config.py) parses this file
# to derive its required-vars list and category sections. To add a new
# var:
#   1. Add it under the right `# === <Section> ===` header below.
#   2. Add a `# tier: required|recommended|optional` line above it.
#   3. The CI workflow .github/workflows/config-check.yml will catch
#      placeholder values automatically — no other change needed.
#
# Tier semantics:
#   required    — boot will fail without it. CI fails on absence/placeholder.
#   recommended — feature degrades gracefully (e.g. one of the LLM keys);
#                 CI warns but doesn't fail unless --ignore-optional is OFF.
#   optional    — not needed for the default code path. CI never fails.

# === Database ===
# tier: required
SUPABASE_URL=https://your-project.supabase.co
# tier: required
SUPABASE_SERVICE_KEY=CHANGE_ME
# tier: optional
SUPABASE_ANON_KEY=
# tier: optional
DATABASE_URL=
# tier: optional
SUPABASE_DB_URL=
# tier: optional
POSTGRES_URL=

# === LLM Providers (>=1 required, all recommended) ===
# tier: required
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# tier: required
OPENAI_API_KEY=sk-CHANGE_ME
# tier: recommended
GEMINI_API_KEY=
# tier: recommended
GOOGLE_API_KEY=
# tier: recommended
DEEPSEEK_API_KEY=
# tier: recommended
MOONSHOT_API_KEY=
# tier: recommended
KIMI_API_KEY=

# Per-agent provider override (rare — only when you want a non-default routing).
# Leave blank to let the router infer from the model name.
# tier: optional
COMPANY_AGENT_PROVIDER=
# tier: optional
RIZWAN_AGENT_PROVIDER=
# tier: optional
INTERVIEW_AGENT_PROVIDER=
# tier: optional
BOSS_AGENT_PROVIDER=
# tier: optional
JOB_SCOUT_PROVIDER=

# === Apify (deep research) ===
# tier: recommended
APIFY_TOKEN=

# === Search ===
# tier: recommended
SERPER_API_KEY=

# === Redis (Sprint 1, queue worker) ===
# tier: optional
REDIS_URL=redis://localhost:6379/0

# === Eval harness ===
# tier: optional
EVAL_GOLDEN_DIR=evals/golden
# tier: optional
ANTHROPIC_PROMPT_CACHE_ENABLED=false

# === Auth (Sprint 1, multi-tenancy) ===
# tier: optional
SUPABASE_JWT_SECRET=
# 1=skip auth and short-circuit to user_001 (self-use mode); 0=require JWT
# tier: optional
RIZWAN_SINGLE_USER_MODE=1

# === Worker ===
# tier: optional
WORKER_CONCURRENCY=1
# tier: optional
ORPHAN_REAPER_INTERVAL_MIN=5

# === G2 Resume Builder Graph ===
# tier: optional
USE_G2_GRAPH=false
# tier: optional
G2_MAX_COST_USD=5.0
# tier: optional
G2_MIN_PERSONA_QUALITY=medium
# tier: optional
G2_INSIDER_EXPERT_MODEL=
# tier: optional
G2_ADVOCATE_MODEL=
# tier: optional
G2_META_CRITIC_MODEL=
# tier: optional
G2_WRITER_MODEL=
# tier: optional
G2_ATS_CRITIC_A_MODEL=
# tier: optional
G2_ATS_CRITIC_B_MODEL=
# tier: optional
G2_ORCHESTRATOR_MODEL=
# tier: optional
G2_POLISHER_MODEL=

# === G3 Interview Prep Graph ===
# tier: optional
USE_G3_GRAPH=false
# tier: optional
G3_MAX_COST_USD=3.0
# tier: optional
G3_MIN_PERSONA_QUALITY=medium
# tier: optional
G3_BEHAVIORAL_PREDICTOR_MODEL=
# tier: optional
G3_TECHNICAL_PREDICTOR_MODEL=
# tier: optional
G3_DOMAIN_PREDICTOR_MODEL=
# tier: optional
G3_STAR_MATCHER_MODEL=
# tier: optional
G3_MOCK_INTERVIEWER_MODEL=
# tier: optional
G3_MOCK_CRITIC_MODEL=

# === Email (boss-agent daily digest) ===
# tier: optional
SENDGRID_API_KEY=
# tier: optional
DIGEST_EMAIL_TO=rizwanzaffar.pk@gmail.com
# tier: optional
DIGEST_EMAIL_FROM=noreply@your-domain.com

# === Cost alerts (Slack preferred, SendGrid fallback) ===
# tier: optional
SLACK_WEBHOOK_URL=
# tier: optional
ALERT_EMAIL_TO=
# tier: optional
DAILY_COST_ALERT_USD=20
# tier: optional
WEEKLY_COST_DIGEST=true
# tier: optional
DAILY_ALERT_TIME=22:00
# tier: optional
WEEKLY_DIGEST_TIME=09:00

# === Railway / Deployment ===
# tier: required
PORT=8000
# tier: required
ENVIRONMENT=development
# tier: required
SECRET_KEY=CHANGE_ME

# === Scheduling ===
# tier: optional
JOB_SCOUT_TIME=09:00
# tier: optional
BOSS_AGENT_TIME=21:00
# tier: optional
TIMEZONE=Asia/Dubai
# tier: optional
START_MODE=
