# ── AI Models ────────────────────────────────────────────────────────────────
# Required (existing):
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Optional — Phase 0 multi-LLM router. Add when you arrange keys.
# Get them at:
#   Gemini:    https://aistudio.google.com/apikey
#   DeepSeek:  https://platform.deepseek.com/api_keys
#   Kimi:      https://platform.moonshot.ai/console/api-keys
GOOGLE_API_KEY=                        # Gemini 2.5 Pro (G1 synth + G2 insider/meta-critic)
DEEPSEEK_API_KEY=                      # V3 (batch scoring) + R1 (ATS critic, mock critic)
KIMI_API_KEY=                          # K2 (red-flag verify, ensemble ATS critic)

# Per-agent provider override (rare — only when you want a non-default routing).
# Leave blank to let the router infer from the model name.
COMPANY_AGENT_PROVIDER=
RIZWAN_AGENT_PROVIDER=
INTERVIEW_AGENT_PROVIDER=
BOSS_AGENT_PROVIDER=
JOB_SCOUT_PROVIDER=

# ── G2 Resume Builder Graph (Phase 1+) ───────────────────────────────────────
# Master switch — set to "true" / "1" / "yes" to route resume builds through
# the new 12-node multi-LLM LangGraph instead of the legacy CompanyAgent
# single-prompt path. Defaults to OFF until you've added Gemini/DeepSeek/Kimi
# keys above and Railway is redeployed with the new requirements.
USE_G2_GRAPH=false

# Per-build production-safety cost cap (Phase 1.11). The orchestrator forces
# convergence when cumulative spend hits this limit. Override per-build via
# POST /jobs/{id}/generate-resume?max_cost_usd=10
G2_MAX_COST_USD=5.0

# Persona quality gate (Phase 1.12). Refuses builds for companies whose
# persona quality is below this threshold. Tiers: high / medium / low.
# 'medium' (default) blocks the 5 'low' personas (Visa, Thunes, Wio Bank,
# Payoneer, "Merchant Acquiring …"). Override per-build via ?force=true.
G2_MIN_PERSONA_QUALITY=medium

# Per-node model overrides — leave commented to use the sane defaults.
# Uncomment + set if you want a different model for a specific node.
# G2_INSIDER_EXPERT_MODEL=gemini-2.5-pro
# G2_ADVOCATE_MODEL=claude-opus-4-5-20251101
# G2_META_CRITIC_MODEL=gemini-2.5-pro
# G2_WRITER_MODEL=claude-opus-4-5-20251101
# G2_ATS_CRITIC_A_MODEL=deepseek-reasoner
# G2_ATS_CRITIC_B_MODEL=kimi-k2
# G2_ORCHESTRATOR_MODEL=claude-opus-4-5-20251101
# G2_POLISHER_MODEL=claude-opus-4-5-20251101

# Optional — langgraph-checkpoint-postgres connection string. Lets G2 resume
# mid-flight if the API server crashes between nodes. Falls back to in-memory
# checkpointing if unset (you lose crash recovery but the graph still runs).
# Format: postgresql://user:pass@host:port/dbname
SUPABASE_DB_URL=

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Search ───────────────────────────────────────────────────────────────────
SERPER_API_KEY=your-serper-key-here   # Free at serper.dev (2500 searches/month)

# ── Email (optional — for boss-agent daily digest) ───────────────────────────
SENDGRID_API_KEY=your-sendgrid-key-here
DIGEST_EMAIL_TO=rizwanzaffar.pk@gmail.com
DIGEST_EMAIL_FROM=noreply@your-domain.com

# ── Phase 1.10: cost alerts (Slack preferred, SendGrid fallback) ─────────────
# Slack: create incoming-webhook at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=                          # paste full https://hooks.slack.com/... URL
ALERT_EMAIL_TO=                             # falls back to DIGEST_EMAIL_TO if blank
DAILY_COST_ALERT_USD=20                     # fire alert when today's spend exceeds this
WEEKLY_COST_DIGEST=true                     # set false to disable Sunday digest
DAILY_ALERT_TIME=22:00                      # daily check time, after boss audit
WEEKLY_DIGEST_TIME=09:00                    # Sunday digest send time

# ── Railway / Deployment ─────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development   # development | production
SECRET_KEY=your-random-secret-key-change-this

# ── Scheduling ────────────────────────────────────────────────────────────────
JOB_SCOUT_TIME=09:00       # Daily job search time (Dubai/UTC+4)
BOSS_AGENT_TIME=21:00      # Evening audit time
TIMEZONE=Asia/Dubai
