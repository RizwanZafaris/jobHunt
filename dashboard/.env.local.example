# Railway API URL (your deployed Railway service)
NEXT_PUBLIC_API_URL=https://your-railway-app.up.railway.app

# Secret key (must match X-Secret-Key header expected by FastAPI)
API_SECRET_KEY=your-secret-key-here

# ── Multi-tenant auth (Phase 1, P1-7) — all optional; default is single-user ──
# Master flag for the dashboard. Default (unset or "1") = single-user mode:
# the proxy forwards X-Secret-Key exactly as before. Set to "0" to enable
# per-user JWT forwarding (proxy reads the Supabase session and forwards
# Authorization: Bearer <access_token>). Login/signup UI is Phase 4.
NEXT_PUBLIC_SINGLE_USER_MODE=1

# Supabase project (only needed when NEXT_PUBLIC_SINGLE_USER_MODE=0)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
